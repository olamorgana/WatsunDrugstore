<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Watsun Drugstore</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/Site.css">
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- NAVIGATION BAR - Navy -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1a237e;">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">Watsun Drugstore</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Cart/ViewCart">My Cart</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Register">Register</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <!-- FOOTER - Navy -->
    <footer class="text-white text-center py-3 mt-auto" style="background-color: #1a237e;">
        <div class="container">
            <p class="mb-0">&copy; 2026 Watsun Drugstore. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold text-primary">Your Shopping Cart</h2>
        <p class="text-muted">Review your selected cosmetics, skincare, and wellness items before checkout.</p>
    </div>
</div>

<div class="row">
    <!-- CART ITEMS TABLE -->
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col">Category</th>
                            <th scope="col" style="width: 100px;">Price</th>
                            <th scope="col" style="width: 90px;">Qty</th>
                            <th scope="col" style="width: 110px;">Subtotal</th>
                            <th scope="col" class="text-center" style="width: 80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- MOCKUP ITEM 1: Skincare -->
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="~/images/the_ordinary_serum.jpg" alt="Serum" class="img-thumbnail me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                    <div>
                                        <span class="fw-bold d-block text-dark">The Ordinary Niacinamide 10%</span>
                                        <small class="text-muted">30ml Serum</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-info text-dark fw-semibold">Skincare</span></td>
                            <td class="fw-semibold text-dark">RM 35.00</td>
                            <td>
                                <form method="post" asp-action="UpdateQuantity" asp-controller="Cart" class="d-inline">
                                    <input type="hidden" name="productId" value="1" />
                                    <input type="number" name="quantity" value="1" min="1" class="form-control form-control-sm text-center fw-semibold" style="width: 60px;" />
                                </form>
                            </td>
                            <td class="fw-bold text-primary">RM 35.00</td>
                            <td class="text-center">
                                <form method="post" asp-action="RemoveFromCart" asp-controller="Cart" class="d-inline">
                                    <input type="hidden" name="productId" value="1" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Item">Remove</button>
                                </form>
                            </td>
                        </tr>

                        <!-- MOCKUP ITEM 2: Cosmetics -->
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="~/images/maybelline_mascara.jpg" alt="Mascara" class="img-thumbnail me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                    <div>
                                        <span class="fw-bold d-block text-dark">Maybelline Lash Sensational</span>
                                        <small class="text-muted">Waterproof Mascara</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-success text-white fw-semibold">Cosmetics & Beauty</span></td>
                            <td class="fw-semibold text-dark">RM 42.90</td>
                            <td>
                                <form method="post" asp-action="UpdateQuantity" asp-controller="Cart" class="d-inline">
                                    <input type="hidden" name="productId" value="2" />
                                    <input type="number" name="quantity" value="2" min="1" class="form-control form-control-sm text-center fw-semibold" style="width: 60px;" />
                                </form>
                            </td>
                            <td class="fw-bold text-primary">RM 85.80</td>
                            <td class="text-center">
                                <form method="post" asp-action="RemoveFromCart" asp-controller="Cart" class="d-inline">
                                    <input type="hidden" name="productId" value="2" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Item">Remove</button>
                                </form>
                            </td>
                        </tr>

                        <!-- MOCKUP ITEM 3: Health & Wellness -->
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="~/images/vitamin_c.jpg" alt="Vitamin C" class="img-thumbnail me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                    <div>
                                        <span class="fw-bold d-block text-dark">Ester-C Vitamin C 500mg</span>
                                        <small class="text-muted">50 Tablets</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-warning text-dark fw-semibold">Health & Wellness</span></td>
                            <td class="fw-semibold text-dark">RM 55.00</td>
                            <td>
                                <form method="post" asp-action="UpdateQuantity" asp-controller="Cart" class="d-inline">
                                    <input type="hidden" name="productId" value="4" />
                                    <input type="number" name="quantity" value="1" min="1" class="form-control form-control-sm text-center fw-semibold" style="width: 60px;" />
                                </form>
                            </td>
                            <td class="fw-bold text-primary">RM 55.00</td>
                            <td class="text-center">
                                <form method="post" asp-action="RemoveFromCart" asp-controller="Cart" class="d-inline">
                                    <input type="hidden" name="productId" value="4" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Item">Remove</button>
                                </form>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
            <!-- CART UTILITY BUTTONS -->
            <div class="card-footer bg-white d-flex justify-content-between py-3">
                <a href="/" class="btn btn-outline-primary fw-semibold">Continue Shopping</a>
                <form method="post" asp-action="ClearCart" asp-controller="Cart" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger fw-semibold">Clear Shopping Cart</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ORDER SUMMARY -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0 fw-semibold">Order Summary</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Subtotal (3 items)</span>
                    <span class="fw-semibold text-dark">RM 175.80</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-secondary">Government Tax (6% SST)</span>
                    <span class="fw-semibold text-dark">RM 10.55</span>
                </div>
                <hr class="text-muted" />
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold text-dark fs-5">Final Total</span>
                    <span class="fw-bold text-primary fs-4">RM 186.35</span>
                </div>

                <a href="/Cart/Checkout" class="btn btn-success w-100 py-2 fw-bold fs-5 shadow-sm">Proceed to Checkout</a>
            </div>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold text-primary">Secured Checkout</h2>
        <p class="text-muted">Please provide your shipping and billing details to complete your order.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-7 mb-4">
        <div class="card border-0 shadow-sm p-4 bg-white">
            <h4 class="mb-4 fw-bold text-dark border-bottom pb-2">Shipping & Delivery</h4>

            <form method="post" asp-action="PlaceOrder" asp-controller="Cart">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary">Full Name</label>
                    <input type="text" name="fullName" class="form-control" placeholder="e.g. Ahmad Bin Ali" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary">Phone Number</label>
                    <input type="tel" name="phone" class="form-control" placeholder="e.g. 0123456789" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary">Shipping Address</label>
                    <textarea name="address" class="form-control" rows="3" placeholder="Street Name, Taman, Section" required></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">Postcode</label>
                        <input type="text" name="postcode" class="form-control" placeholder="e.g. 75300" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">State</label>
                        <select name="state" class="form-select" required>
                            <option value="">Choose State...</option>
                            <option>Melaka</option>
                            <option>Selangor</option>
                            <option>Kuala Lumpur</option>
                            <option>Johor</option>
                            <option>Penang</option>
                        </select>
                    </div>
                </div>

                <h4 class="mt-4 mb-4 fw-bold text-dark border-bottom pb-2">Payment Method</h4>
                <div class="mb-4">
                    <div class="form-check form-check-inline me-4">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="COD" checked>
                        <label class="form-check-label fw-semibold text-dark" for="cod">
                            Cash on Delivery (COD)
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="fpx" value="FPX" disabled>
                        <label class="form-check-label fw-semibold text-muted" for="fpx">
                            Online Banking (FPX) <span class="badge bg-secondary text-white">Maintenance</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm py-2">Place Order Now</button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="card-title mb-0 fw-semibold">Your Order Summary</h5>
            </div>
            <div class="card-body bg-light">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">The Ordinary Serum (x1)</span>
                    <span class="text-dark fw-semibold">RM 35.00</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Maybelline Mascara (x2)</span>
                    <span class="text-dark fw-semibold">RM 85.80</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Ester-C Vitamin C (x1)</span>
                    <span class="text-dark fw-semibold">RM 55.00</span>
                </div>

                <hr class="text-muted" />

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Subtotal</span>
                    <span class="text-dark fw-semibold">RM 175.80</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-secondary">SST (6%)</span>
                    <span class="text-dark fw-semibold">RM 10.55</span>
                </div>

                <div class="p-3 bg-white rounded border d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark fs-5">Amount Due:</span>
                    <span class="fw-bold text-success fs-4">RM 186.35</span>
                </div>
            </div>
        </div>

        <div class="text-center">
            <a href="/Cart/ViewCart" class="btn btn-sm btn-link text-decoration-none fw-semibold">Back to Edit Cart</a>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Admin Management Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- TODO PERSON 4: Add [Authorize(Roles = "Admin")] to controller action -->

<div class="row mb-4 align-items-center">
    <div class="col-md-8 text-center text-md-start">
        <h2 class="fw-bold text-dark">Watsun Control Panel</h2>
        <p class="text-muted mb-0">Executive Sales Insights, Business Analytics & Detailed Reports.</p>
    </div>
    <div class="col-md-4 text-center text-md-end mt-3 mt-md-0">
        <span class="badge bg-danger p-2 fs-6 shadow-sm">Secure Admin Access</span>
    </div>
</div>

<h4 class="fw-bold text-primary mb-3">1. Executive Summary</h4>
<div class="row mb-5">
    <div class="col-md-4 mb-3">
        <div class="card bg-primary text-white border-0 shadow-sm p-3">
            <small class="fw-semibold text-white-50 text-uppercase">Total Gross Revenue</small>
            <h2 class="fw-bold my-2">RM 5,420.50</h2>
            <small class="text-white-50">Inclusive of 6% SST Cukai</small>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card bg-success text-white border-0 shadow-sm p-3">
            <small class="fw-semibold text-white-50 text-uppercase">Total Successful Orders</small>
            <h2 class="fw-bold my-2">42 Orders</h2>
            <small class="text-white-50">From registered customers</small>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card bg-warning text-dark border-0 shadow-sm p-3">
            <small class="fw-semibold text-dark-50 text-uppercase">Top Performing Category</small>
            <h2 class="fw-bold my-2">Skincare</h2>
            <small class="text-dark-50">Highest unit sales volume</small>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-primary mb-0">2. Detailed Sales Report</h4>
</div>

<div class="card border-0 shadow-sm mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-white">
                <tr>
                    <th scope="col" style="width: 100px;">Order ID</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Items Purchased</th>
                    <th scope="col" style="width: 130px;">Tax (6% SST)</th>
                    <th scope="col" style="width: 140px;">Total Paid (RM)</th>
                    <th scope="col" style="width: 150px;">Order Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold text-secondary">#WTS-0042</td>
                    <td>
                        <div class="fw-bold text-dark">Ahmad Bin Ali</div>
                        <small class="text-muted">ahmad@gmail.com</small>
                    </td>
                    <td>
                        <span class="d-block text-muted small">The Ordinary Serum (x1)</span>
                        <span class="d-block text-muted small">Maybelline Mascara (x2)</span>
                        <span class="d-block text-muted small">Ester-C Vitamin C (x1)</span>
                    </td>
                    <td class="text-dark">RM 10.55</td>
                    <td class="fw-bold text-primary">RM 186.35</td>
                    <td class="text-muted small">08 June 2026<br>20:15</td>
                </tr>

                <tr>
                    <td class="fw-bold text-secondary">#WTS-0041</td>
                    <td>
                        <div class="fw-bold text-dark">Siti Nurhaliza</div>
                        <small class="text-muted">siti@yahoo.com</small>
                    </td>
                    <td>
                        <span class="d-block text-muted small">Head & Shoulders Shampoo (x2)</span>
                    </td>
                    <td class="text-dark">RM 2.22</td>
                    <td class="fw-bold text-primary">RM 39.22</td>
                    <td class="text-muted small">08 June 2026<br>14:30</td>
                </tr>

            </tbody>
        </table>
    </div>
</div>